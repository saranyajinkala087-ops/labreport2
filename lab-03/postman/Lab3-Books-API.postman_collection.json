    {
      "name": "POST valid (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Collection Book\",\n  \"author\": \"Test Author\",\n  \"price\": 425,\n  \"pages\": 210\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\",()=>pm.response.to.have.status(201));",
              "pm.test(\"response is JSON\",()=>pm.response.to.be.json);",
              "const body=pm.response.json();",
              "pm.test(\"created book response shape\",()=>{pm.expect(body.message).to.be.a(\"string\");pm.expect(body.data.id).to.be.a(\"number\");pm.expect(body.data.title).to.eql(\"Postman Collection Book\");});",
              "pm.collectionVariables.set(\"createdBookId\", body.data.id);"
            ]
          }
        }
      ]
    },
