  "item": [
    {
      "name": "GET all (defaults)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"response is JSON\",()=>pm.response.to.be.json);",
              "const body=pm.response.json();",
              "pm.test(\"list response shape\",()=>{pm.expect(body.data).to.be.an(\"array\");pm.expect(body).to.have.property(\"total\");pm.expect(body).to.have.property(\"limit\");pm.expect(body).to.have.property(\"offset\");});"
            ]
          }
        }
      ]
    },
